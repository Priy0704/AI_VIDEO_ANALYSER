# Application Settings
APP_NAME="AI Video Analyser & Chat"
APP_ENV=development
DEBUG=true
PORT=8080
HOST=0.0.0.0

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_analyser
# When running inside Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/video_analyser

# AI Model Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Alternative: gemini-2.0-flash

# Processing Pipeline Config
FRAME_SAMPLE_INTERVAL_SEC=3.0
MAX_CONCURRENT_WORKERS=2
MAX_VIDEO_SIZE_MB=500
CONFIDENCE_THRESHOLD=0.70

# Storage Paths
STORAGE_DIR=./data
UPLOAD_DIR=./data/uploads
KEYFRAME_DIR=./data/keyframes
